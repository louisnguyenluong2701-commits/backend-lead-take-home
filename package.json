{
  "name": "mini-wallet-service",
  "version": "1.0.0",
  "private": true,
  "description": "Take-home starter: mini wallet service",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:test": "cross-env NODE_ENV=test sequelize-cli db:migrate",
    "test": "npm run db:migrate:test && cross-env NODE_ENV=test jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,js}' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.{ts,js}' 'test/**/*.ts' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1"
  }
}
